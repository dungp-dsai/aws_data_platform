import boto3


s3 = boto3.client(
    "s3",
    endpoint_url="http://localhost:4566",
    region_name="us-east-1",
    aws_access_key_id="test",
    aws_secret_access_key="test",
)


bucket = "data-platform-raw"


s3.put_object(
    Bucket=bucket,
    Key="incoming/prs_batch_4.csv",
    Body=b"repo,pr_number,author_type\nexample/demo,7,human\n",
)


from uuid import uuid4

key = f"incoming/debug-{uuid4().hex[:8]}.csv"
result = s3.put_object(
    Bucket="data-platform-raw",
    Key=key,
    Body=b"repo,pr_number,author_type\nexample/demo,8,human\n",
)
print(result["ResponseMetadata"]["HTTPStatusCode"], key)



