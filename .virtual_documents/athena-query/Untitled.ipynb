import boto3


s3 = boto3.client(
    "s3",
    endpoint_url="http://localhost:4566",
    region_name="us-east-1",
    aws_access_key_id="test",
    aws_secret_access_key="test",
)

batch_2 = """repo,pr_number,author_type
example/demo,3,agent
example/demo,4,agent
example/demo,5,human
"""

s3.put_object(
    Bucket="data-platform-raw",
    Key="prs_batch_2.csv",
    Body=batch_2.encode("utf-8"),
)



